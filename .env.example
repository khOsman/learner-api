PORT=3000

# Salesforce External Client App (JWT Bearer flow)
SF_CLIENT_ID=<Consumer Key>
SF_USERNAME=<integration user's Salesforce username>
SF_LOGIN_URL=https://login.salesforce.com
SF_API_VERSION=v66.0
# Private key on one line, line breaks written as \n
SF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# One key per consumer: name:key,name:key  (make a key with: npm run new-key)
API_KEYS=osman:<key>,teamA:<key>

# Local testing only: lets a browser on this machine call /learners without a key.
# Never set to true on the deployed server.
ALLOW_LOCAL_NO_KEY=false
